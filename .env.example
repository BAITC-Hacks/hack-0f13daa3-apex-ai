# Укажите ваш API ключ OpenAI (или другого провайдера, совместимого с OpenAI API)
OPENAI_API_KEY=your_api_key_here

# Если используете альтернативного провайдера, раскомментируйте и измените:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Название модели (по умолчанию gpt-3.5-turbo)
# MODEL_NAME=gpt-4o-mini

# Включить мок-данные для тестирования без API ключа (True / False)
MOCK_LLM=True
